<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.skyscope.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Skyscope - Flight Board" />

    <!-- Search Bar -->
    <TextField fx:id="searchField" promptText="Search by flight number, airline, or destination..." />

    <!-- Flight Table View with the New Pin Column -->
    <TableView fx:id="flightTable" prefHeight="300.0" prefWidth="600.0">
      <columns>
          <TableColumn fx:id="colPin" prefWidth="60.0" text="Pin" />
          <TableColumn fx:id="colFlightNum" prefWidth="90.0" text="Flight #" />
          <TableColumn fx:id="colAirline" prefWidth="120.0" text="Airline" />
          <TableColumn fx:id="colDestination" prefWidth="160.0" text="Destination" />
          <TableColumn fx:id="colTime" prefWidth="100.0" text="Time" />
          <TableColumn fx:id="colGate" prefWidth="80.0" text="Gate" />
      </columns>
    </TableView>
</VBox>